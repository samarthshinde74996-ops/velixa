# ─── AI (Required) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
# Get free key at: https://console.anthropic.com/settings/api-keys

# ─── Auth (Required) ──────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-random-secret-string-here
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# ─── Database (Required) ──────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
# Using SQLite for local dev — free, no setup needed!
# For production use: postgresql://user:pass@host:5432/sheetai

# ─── Payments - Razorpay (Optional for paid plans) ───────────────────────────
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY
RAZORPAY_KEY_SECRET=YOUR_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY
# Get free test keys at: https://dashboard.razorpay.com

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SheetAI
